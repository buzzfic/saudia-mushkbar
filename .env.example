# ---------------------------------------------------------------------------
# Public site URL. Used for canonical URLs, Open Graph, sitemap and robots.txt.
# Must be the production domain in production; never a preview domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.saudiamushkbar.com

# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID carried over from the WordPress site.
# Leave unset in preview/staging so test traffic is not recorded.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3VY9D6RKJF

# ---------------------------------------------------------------------------
# Appointment request form delivery (server-side only — never exposed to the
# browser). If RESEND_API_KEY is not set the form stays up but tells the
# visitor to call the office instead of silently dropping the message.
#
# Create a key at https://resend.com and verify the sending domain first.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender on your domain, e.g. "Website <website@saudiamushkbar.com>"
CONTACT_FROM_EMAIL=
# Where appointment requests should be delivered.
CONTACT_TO_EMAIL=

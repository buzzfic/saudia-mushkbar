# ---------------------------------------------------------------------------
# Public site URL. Used for canonical URLs, Open Graph, sitemap and robots.txt.
#
# Optional. Leave it UNSET (or delete the variable entirely) to use the
# production domain. Do not define it with an empty value — set a real URL or
# nothing at all. An empty or malformed value falls back to the production
# domain rather than breaking the build.
#
# Only set this if a deployment should canonicalise to itself, e.g. a staging
# site that must not point search engines at production.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.saudiamushkbar.com

# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID carried over from the WordPress site.
# Analytics only load in production builds. Set to an empty value to disable
# tracking entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3VY9D6RKJF
